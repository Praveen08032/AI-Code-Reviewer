GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-latest
# Email/password sign-up needs SMTP delivery; no OAuth credentials are needed.
# Run setup_owner.py from the backend terminal to claim the private owner page.
# Comma-separated frontend origins; no trailing paths. Required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
# Required to deliver real verification codes; no console-code fallback exists.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Per-account limits, shared by workers. At most two AI calls can run per account.
REVIEW_REQUESTS_PER_MINUTE=5
CHAT_REQUESTS_PER_MINUTE=10
# SQLite is the development default. Use persistent PostgreSQL when hosting.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
